# URL del backend InCrowd (REST API). Stessa variabile usata dal layer api/*.
VITE_BACKEND_URL=http://localhost:3000

# Google OAuth client id (usato nella Fase 6 — Auth). Deve coincidere con
# GOOGLE_CLIENT_ID del backend (audience del verificatore id-token).
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Controlli di sicurezza password: "true" attiva le regole forti (Signup/Admin),
# "false" usa la validazione semplice (min 6 caratteri) per lo sviluppo.
VITE_ENABLE_SECURITY_CONTROLS=true
